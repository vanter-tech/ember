# Edge reverse proxy for the hosted API. Deployed as the `caddy` service in
# deploy/docker-compose.prod.yml. This file is bind-mounted to
# /opt/ember/caddy/Caddyfile on the VM; the two PEMs it references
# (/opt/ember/caddy/origin.pem, /opt/ember/caddy/origin.key) are a Cloudflare
# Origin Certificate created in the dashboard (SSL/TLS -> Origin Server), not
# committed. Cloudflare must be set to SSL mode "Full (strict)".

api.ember.vanter.net {
	tls /certs/origin.pem /certs/origin.key

	# app listens on plain HTTP inside the compose network; it does not publish a
	# host port. Caddy adds X-Forwarded-* and leaves Cloudflare's CF-Connecting-IP
	# header intact, which is what AuthRateLimiterFilter keys the client IP on.
	reverse_proxy app:8080

	encode gzip
}

# Public file downloads (Windows installers: Ember Agent, Ember Hub).
# Reverse-proxies to the public GCS bucket gs://ember-downloads-prod via the
# path-style endpoint — objects there are world-readable, so no auth is added.
# Cloudflare caches .exe responses by default, so the VM only serves cache
# misses. The Cloudflare Origin Certificate mounted above must cover this
# hostname (create it for *.ember.vanter.net if it was issued api-only).
downloads.ember.vanter.net {
	tls /certs/origin.pem /certs/origin.key

	@methods method GET HEAD
	handle @methods {
		rewrite * /ember-downloads-prod{uri}
		reverse_proxy https://storage.googleapis.com {
			header_up Host storage.googleapis.com
		}
	}
	respond 405
}
