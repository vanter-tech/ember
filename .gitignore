# Environment secrets — never commit real values, only .env.example
.env
.env.local
.env.*.local

# Scratch workspace for superpowers:subagent-driven-development plan execution
.superpowers/

# Hub distributable's bundled frontend build output — regenerate via ember-hub/build-frontend.ps1
backend/src/main/resources/static/

# Hub installer build — real baked config, downloaded vendor binaries, and build output
ember-hub/build.env
ember-hub/.vendor-cache/
ember-hub/dist/

# Hub license signing keys — never commit the PRIVATE key. The public key is
# committed (ember-hub/keys/hub-public-key.der) so every build verifies licenses
# against the same prod key with no manual per-machine step.
ember-hub/keys/*
!ember-hub/keys/hub-public-key.der
