---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Pricing from '../components/Pricing.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro'
import StickyMobileCTA from '../components/StickyMobileCTA.tsx';
import CookieBanner from '../components/CookieBanner.tsx';
---

<Layout
	title="Ember — Restaurant Management Platform"
	description="Collaborative real-time ordering, kitchen display, floor management, and analytics for modern restaurants."
>
	<Nav />
	<Hero />
	<Features />
	<Pricing />
	<CTASection />
	<Footer />
	<StickyMobileCTA client:load />
	<CookieBanner client:load />
</Layout>
