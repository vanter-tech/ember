---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Gracias por contactarnos — Ember"
	description="Recibimos tu mensaje. Nuestro equipo se pondrá en contacto a la brevedad."
>
	<Nav />
	<section class="border-b-[3px] border-foreground bg-background">
		<div class="mx-auto max-w-4xl px-6 py-24 text-center md:py-32">
			<p class="font-mono text-sm font-bold uppercase tracking-widest text-accent">Mensaje enviado</p>
			<h1 class="mt-4 text-3xl font-black uppercase leading-[0.95] tracking-tight md:text-5xl">
				¡Gracias por escribirnos!
			</h1>
			<p class="mx-auto mt-6 max-w-xl text-lg font-medium">
				Recibimos tu mensaje y nuestro equipo se va a poner en contacto a la brevedad.
			</p>
			<div class="mt-8 flex justify-center">
				<a
					href="/"
					class="border-[3px] border-foreground bg-accent px-8 py-4 text-center text-sm font-black uppercase tracking-wide text-background shadow-brutal"
				>
					Volver al inicio
				</a>
			</div>
		</div>
	</section>
	<Footer />
</Layout>
