---
import InfoLayout from '../../layouts/InfoLayout.astro';
import { getLang, useTranslations, localizePath } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const how = [
	{ title: t('local.page.how.1.title'), body: t('local.page.how.1.body') },
	{ title: t('local.page.how.2.title'), body: t('local.page.how.2.body') },
	{ title: t('local.page.how.3.title'), body: t('local.page.how.3.body') },
	{ title: t('local.page.how.4.title'), body: t('local.page.how.4.body') },
];

const requirements = [
	{ label: t('local.page.req.system'), value: t('local.page.req.system.v') },
	{ label: t('local.page.req.pc'), value: t('local.page.req.pc.v') },
	{ label: t('local.page.req.net'), value: t('local.page.req.net.v') },
	{ label: t('local.page.req.terminals'), value: t('local.page.req.terminals.v') },
	{ label: t('local.page.req.print'), value: t('local.page.req.print.v') },
	{ label: t('local.page.req.internet'), value: t('local.page.req.internet.v') },
];
---

<InfoLayout title={t('local.page.title')} description={t('local.page.desc')}>
	<p class="text-xs font-semibold uppercase tracking-wider text-primary">{t('local.page.eyebrow')}</p>
	<h1 class="mt-3 text-3xl font-bold tracking-tight text-foreground md:text-4xl">{t('local.page.h1')}</h1>
	<p class="mt-4 leading-relaxed text-muted-foreground">
		{t('local.page.lede')}
	</p>

	<section class="mt-10 scroll-mt-24">
		<h2 class="text-xl font-bold tracking-tight text-foreground">{t('local.page.how.title')}</h2>
		<div class="mt-5 grid gap-4 sm:grid-cols-2">
			{how.map((item) => (
				<div class="rounded-lg border border-border bg-card p-5 shadow-sm">
					<h3 class="text-base font-semibold tracking-tight text-card-foreground">{item.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.body}</p>
				</div>
			))}
		</div>
	</section>

	<section class="mt-10 scroll-mt-24">
		<h2 class="text-xl font-bold tracking-tight text-foreground">{t('local.page.offline.title')}</h2>
		<p class="mt-3 leading-relaxed text-muted-foreground">{t('local.page.offline.body')}</p>
		<p class="mt-3 leading-relaxed text-muted-foreground">{t('local.page.offline.grace')}</p>
	</section>

	<section class="mt-10 scroll-mt-24">
		<h2 class="text-xl font-bold tracking-tight text-foreground">{t('local.page.data.title')}</h2>
		<p class="mt-3 leading-relaxed text-muted-foreground">{t('local.page.data.body')}</p>
	</section>

	<section class="mt-10 scroll-mt-24">
		<h2 class="text-xl font-bold tracking-tight text-foreground">{t('local.page.support.title')}</h2>
		<p class="mt-3 leading-relaxed text-muted-foreground">{t('local.page.support.body')}</p>
	</section>

	<section class="mt-10 scroll-mt-24">
		<h2 class="text-xl font-bold tracking-tight text-foreground">{t('local.page.req.title')}</h2>
		<dl class="mt-5 divide-y divide-border overflow-hidden rounded-lg border border-border bg-card">
			{requirements.map((row) => (
				<div class="grid gap-1 p-4 sm:grid-cols-[160px_1fr] sm:gap-4">
					<dt class="text-sm font-semibold text-card-foreground">{row.label}</dt>
					<dd class="text-sm leading-relaxed text-muted-foreground">{row.value}</dd>
				</div>
			))}
		</dl>
	</section>

	<section class="mt-12 rounded-lg border border-border bg-muted/40 p-6">
		<h2 class="text-lg font-semibold tracking-tight text-foreground">{t('local.page.cta.title')}</h2>
		<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{t('local.page.cta.body')}</p>
		<div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center">
			<a
				href={localizePath('/contacto', lang)}
				class="inline-flex shrink-0 items-center justify-center rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90"
			>
				{t('local.page.cta.button')}
			</a>
			<a
				href={`${localizePath('/planes', lang)}#local`}
				class="text-sm font-medium text-primary transition-colors hover:text-primary/80"
			>
				{t('local.page.cta.plans')} &rarr;
			</a>
		</div>
	</section>
</InfoLayout>
