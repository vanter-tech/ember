---
import InfoLayout from '../../layouts/InfoLayout.astro';
import { getLang, useTranslations } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

/**
 * Para publicar un video, poné su ID de YouTube (lo que sigue a `watch?v=`) en la
 * posición correspondiente. También se acepta una URL completa de YouTube o de
 * Vimeo. Mientras el valor sea null, la tarjeta muestra "Próximamente".
 * El video se abre en un modal al hacer clic; nada de YouTube se carga hasta ese
 * clic (embed en modo `youtube-nocookie`).
 */
const ids: (string | null)[] = ['6rlusWZRnaA', null, null, null, null, null];

function resolveVideo(value: string) {
	if (/^[\w-]{11}$/.test(value)) {
		return {
			thumb: `https://i.ytimg.com/vi/${value}/hqdefault.jpg`,
			embed: `https://www.youtube-nocookie.com/embed/${value}?autoplay=1&rel=0`,
		};
	}
	const yt = value.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([\w-]{11})/);
	if (yt) {
		return {
			thumb: `https://i.ytimg.com/vi/${yt[1]}/hqdefault.jpg`,
			embed: `https://www.youtube-nocookie.com/embed/${yt[1]}?autoplay=1&rel=0`,
		};
	}
	const vm = value.match(/vimeo\.com\/(?:video\/)?(\d+)/);
	if (vm) {
		return { thumb: null, embed: `https://player.vimeo.com/video/${vm[1]}?autoplay=1` };
	}
	return { thumb: null, embed: value };
}

const videos = ids.map((value, i) => ({
	title: t(`videos.${i + 1}.title`),
	body: t(`videos.${i + 1}.body`),
	video: value ? resolveVideo(value) : null,
}));
---

<InfoLayout title={t('videos.title')} description={t('videos.desc')}>
	<p class="text-xs font-semibold uppercase tracking-wider text-primary">{t('info.sidebar')}</p>
	<h1 class="mt-3 text-3xl font-bold tracking-tight text-foreground md:text-4xl">{t('videos.h1')}</h1>
	<p class="mt-4 text-muted-foreground">
		{t('videos.lede')}
	</p>

	<div class="mt-8 grid gap-6 sm:grid-cols-2">
		{videos.map((video) => (
			<div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
				{video.video ? (
					<button
						type="button"
						data-video-open
						data-embed={video.video.embed}
						data-title={video.title}
						aria-label={`${t('videos.play')}: ${video.title}`}
						class="group relative block aspect-video w-full bg-muted"
					>
						{video.video.thumb && (
							<img
								src={video.video.thumb}
								alt=""
								loading="lazy"
								class="absolute inset-0 h-full w-full object-cover"
							/>
						)}
						<span
							class="absolute inset-0 bg-black/20 transition-colors group-hover:bg-black/30"
							aria-hidden="true"
						></span>
						<span
							class="absolute left-1/2 top-1/2 flex size-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-primary text-primary-foreground shadow-md transition-transform group-hover:scale-105"
							aria-hidden="true"
						>
							<svg class="ml-0.5 size-6" viewBox="0 0 24 24" fill="currentColor">
								<path d="M8 5v14l11-7z" />
							</svg>
						</span>
					</button>
				) : (
					<div class="relative aspect-video bg-muted">
						<div class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-muted-foreground">
							<span class="flex size-12 items-center justify-center rounded-full border border-border bg-background">
								<svg class="size-5 text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M8 5v14l11-7z" />
								</svg>
							</span>
							<span class="text-xs font-medium uppercase tracking-wider">{t('videos.soon')}</span>
						</div>
					</div>
				)}
				<div class="p-5">
					<h2 class="text-base font-semibold tracking-tight text-card-foreground">{video.title}</h2>
					<p class="mt-1.5 text-sm text-muted-foreground">{video.body}</p>
				</div>
			</div>
		))}
	</div>

	<dialog
		id="video-modal"
		aria-labelledby="video-modal-title"
		class="w-[min(92vw,64rem)] rounded-xl border border-border bg-card p-0 text-foreground shadow-lg"
	>
		<div class="flex items-center justify-between gap-4 border-b border-border px-4 py-3">
			<p id="video-modal-title" class="text-sm font-semibold text-card-foreground"></p>
			<button
				type="button"
				data-video-close
				aria-label={t('videos.close')}
				class="flex size-8 items-center justify-center rounded-md text-xl leading-none text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
			>
				&times;
			</button>
		</div>
		<div class="aspect-video bg-black">
			<div id="video-modal-frame" class="h-full w-full"></div>
		</div>
	</dialog>
</InfoLayout>

<style is:global>
	#video-modal {
		margin: auto;
	}
	#video-modal::backdrop {
		background-color: rgb(0 0 0 / 0.6);
	}
</style>

<script is:inline>
	(() => {
		const setup = () => {
			const modal = document.getElementById('video-modal');
			if (!modal || typeof modal.showModal !== 'function') return;
			const frame = document.getElementById('video-modal-frame');
			const titleEl = document.getElementById('video-modal-title');

			// Removing the iframe stops playback. Do it on every close path
			// rather than trusting the dialog 'close' event alone.
			const clearFrame = () => frame.replaceChildren();
			const closeModal = () => {
				modal.close();
				clearFrame();
			};

			const openModal = (btn) => {
				titleEl.textContent = btn.getAttribute('data-title') || '';
				const iframe = document.createElement('iframe');
				iframe.src = btn.getAttribute('data-embed');
				iframe.title = titleEl.textContent;
				iframe.allow = 'autoplay; fullscreen; picture-in-picture';
				iframe.allowFullscreen = true;
				iframe.className = 'h-full w-full border-0';
				frame.replaceChildren(iframe);
				modal.showModal();
			};

			modal.addEventListener('close', clearFrame);
			modal.addEventListener('cancel', clearFrame);
			modal.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') clearFrame();
			});
			modal.addEventListener('click', (e) => {
				if (e.target === modal) closeModal();
			});
			modal
				.querySelectorAll('[data-video-close]')
				.forEach((b) => b.addEventListener('click', closeModal));
			document
				.querySelectorAll('[data-video-open]')
				.forEach((b) => b.addEventListener('click', () => openModal(b)));
		};
		document.addEventListener('astro:page-load', setup);
	})();
</script>
