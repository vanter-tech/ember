---
import InfoLayout from '../../layouts/InfoLayout.astro';
import { getLang, useTranslations, localizePath } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const sections = [
	{ title: t('sec.page.tenant.title'), body: t('sec.page.tenant.body') },
	{ title: t('sec.page.access.title'), body: t('sec.page.access.body') },
	{ title: t('sec.page.transit.title'), body: t('sec.page.transit.body') },
	{ title: t('sec.page.backup.title'), body: t('sec.page.backup.body') },
];
---

<InfoLayout title={t('sec.page.title')} description={t('sec.page.desc')}>
	<p class="text-xs font-semibold uppercase tracking-wider text-primary">{t('sec.page.eyebrow')}</p>
	<h1 class="mt-3 text-3xl font-bold tracking-tight text-foreground md:text-4xl">{t('sec.page.h1')}</h1>
	<p class="mt-4 leading-relaxed text-muted-foreground">
		{t('sec.page.lede')}
	</p>

	<div class="mt-10 space-y-6">
		{sections.map((section) => (
			<section class="scroll-mt-24 rounded-lg border border-border bg-card p-6 shadow-sm">
				<h2 class="text-lg font-semibold tracking-tight text-card-foreground">{section.title}</h2>
				<p class="mt-3 text-sm leading-relaxed text-muted-foreground">{section.body}</p>
			</section>
		))}
	</div>

	<section class="mt-6 scroll-mt-24 rounded-lg border border-primary/40 bg-primary/[0.04] p-6">
		<h2 class="text-lg font-semibold tracking-tight text-foreground">{t('sec.page.local.title')}</h2>
		<p class="mt-3 text-sm leading-relaxed text-muted-foreground">{t('sec.page.local.body')}</p>
		<a
			href={localizePath('/info/local', lang)}
			class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-primary transition-colors hover:text-primary/80"
		>
			{t('sec.page.local.cta')}
			<svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
				<path fill-rule="evenodd" d="M7.21 4.21a1 1 0 0 1 1.42 0l5 5a1 1 0 0 1 0 1.42l-5 5a1 1 0 1 1-1.42-1.42L11.59 10 7.21 5.63a1 1 0 0 1 0-1.42Z" clip-rule="evenodd" />
			</svg>
		</a>
	</section>

	<section class="mt-12 rounded-lg border border-border bg-muted/40 p-6">
		<h2 class="text-lg font-semibold tracking-tight text-foreground">{t('sec.page.contact.title')}</h2>
		<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{t('sec.page.contact.body')}</p>
		<a
			href={localizePath('/contacto', lang)}
			class="mt-5 inline-flex items-center justify-center rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90"
		>
			{t('sec.page.contact.cta')}
		</a>
	</section>
</InfoLayout>
