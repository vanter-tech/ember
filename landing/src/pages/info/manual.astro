---
import InfoLayout from '../../layouts/InfoLayout.astro';
import { getLang, useTranslations } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const ids = [
	'primeros-pasos',
	'roles',
	'piso',
	'carrito',
	'kds',
	'cobro',
	'analitica',
	'impresion',
	'configuracion',
	'solucion-problemas',
];
const sections = ids.map((id, i) => ({
	id,
	title: t(`manual.s${i + 1}.title`),
	body: t(`manual.s${i + 1}.body`),
}));
---

<InfoLayout title={t('manual.title')} description={t('manual.desc')}>
	<p class="text-xs font-semibold uppercase tracking-wider text-primary">{t('info.sidebar')}</p>
	<h1 class="mt-3 text-3xl font-bold tracking-tight text-foreground md:text-4xl">{t('manual.h1')}</h1>
	<p class="mt-4 text-muted-foreground">
		{t('manual.lede')}
	</p>

	<nav class="mt-8 rounded-lg border border-border bg-muted/40 p-4">
		<p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t('manual.toc')}</p>
		<ul class="mt-3 grid gap-1.5 sm:grid-cols-2">
			{sections.map((s) => (
				<li>
					<a href={`#${s.id}`} class="text-sm text-primary transition-colors hover:text-primary/80">
						{s.title}
					</a>
				</li>
			))}
		</ul>
	</nav>

	<div class="mt-10 space-y-10">
		{sections.map((s) => (
			<section id={s.id} class="scroll-mt-24">
				<h2 class="text-xl font-bold tracking-tight text-foreground">{s.title}</h2>
				{s.body.split('\n').map((para) => (
					<p class="mt-3 leading-relaxed text-muted-foreground">{para}</p>
				))}
			</section>
		))}
	</div>
</InfoLayout>
