---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLang, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const channels = [
	{
		title: t('cpage.mail.title'),
		body: t('cpage.mail.body'),
		linkLabel: 'tofernandoband01@outlook.com',
		href: 'mailto:tofernandoband01@outlook.com',
		icon: 'mail',
	},
	{
		title: t('cpage.office.title'),
		body: 'Vanter<br />Managua, Nicaragua',
		icon: 'pin',
	},
	{
		title: t('cpage.hours.title'),
		body: t('cpage.hours.body'),
		icon: 'clock',
	},
];
---

<Layout title={t('cpage.title')} description={t('cpage.desc')}>
	<Nav />

	<main id="main-content" tabindex="-1" class="bg-background">
		<div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
			<p class="text-xs font-semibold uppercase tracking-wider text-primary">{t('cpage.eyebrow')}</p>
			<h1 class="mt-4 max-w-2xl text-4xl font-bold leading-tight tracking-tight text-foreground md:text-5xl">
				{t('cpage.h1')}
			</h1>
			<p class="mt-4 max-w-xl text-lg text-muted-foreground">
				{t('cpage.lede')}
			</p>

			<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{channels.map((c) => (
					<div class="flex flex-col rounded-lg border border-border bg-card p-6 shadow-sm">
						<span class="flex size-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
							<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								{c.icon === 'mail' && (
									<>
										<rect x="3" y="5" width="18" height="14" rx="2" />
										<path d="m3 7 9 6 9-6" />
									</>
								)}
								{c.icon === 'pin' && (
									<>
										<path d="M20 10c0 4.4-8 12-8 12s-8-7.6-8-12a8 8 0 0 1 16 0Z" />
										<circle cx="12" cy="10" r="3" />
									</>
								)}
								{c.icon === 'clock' && (
									<>
										<circle cx="12" cy="12" r="9" />
										<path d="M12 7v5l3 2" />
									</>
								)}
							</svg>
						</span>
						<h2 class="mt-4 text-lg font-semibold tracking-tight text-card-foreground">{c.title}</h2>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground" set:html={c.body} />
						{c.href && (
							<a
								href={c.href}
								class="mt-4 text-sm font-medium text-primary transition-colors hover:text-primary/80"
							>
								{c.linkLabel}
							</a>
						)}
					</div>
				))}
			</div>

			<div class="mt-10 flex flex-col gap-4 rounded-lg border border-border bg-muted/40 p-6 sm:flex-row sm:items-center sm:justify-between">
				<p class="text-sm text-muted-foreground">
					{t('cpage.demo.text')}
				</p>
				<a
					href="mailto:tofernandoband01@outlook.com?subject=Quiero%20una%20demo%20de%20Ember"
					class="inline-flex shrink-0 items-center justify-center rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90"
				>
					{t('cpage.demo.cta')}
				</a>
			</div>
		</div>
	</main>

	<Footer />
</Layout>
