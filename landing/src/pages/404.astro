---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Página no encontrada — Ember"
	description="La página que buscas no existe o fue movida."
>
	<Nav />
	<section class="border-b-[3px] border-foreground bg-background">
		<div class="mx-auto max-w-4xl px-6 py-24 text-center md:py-32">
			<p class="font-mono text-8xl font-black uppercase tracking-tight md:text-9xl">404</p>
			<h1 class="mt-4 text-3xl font-black uppercase leading-[0.95] tracking-tight md:text-5xl">
				Esta página no existe
			</h1>
			<p class="mx-auto mt-6 max-w-xl text-lg font-medium">
				Puede que el enlace esté roto o la página se haya movido. Volvé al inicio para seguir
				explorando Ember.
			</p>
			<div class="mt-8 flex justify-center">
				<a
					href="/"
					class="border-[3px] border-foreground bg-accent px-8 py-4 text-center text-sm font-black uppercase tracking-wide text-background shadow-brutal"
				>
					Volver al inicio
				</a>
			</div>
		</div>
	</section>
	<Footer />
</Layout>
