---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/** Imagen importada desde src/assets. */
	src: ImageMetadata;
	alt: string;
	/** Ancho para la optimización de Astro (la altura se infiere). */
	width?: number;
	/** Inclina hacia el otro lado (borde derecho hacia el viewer). */
	flip?: boolean;
	/** Prioridad de carga (usar en imágenes above-the-fold). */
	eager?: boolean;
	/** Clases extra para la <img> (p. ej. anchos responsive md:w-[130%]). */
	class?: string;
	/** Clases extra para el contenedor (p. ej. sangrado md:-mr-10). */
	frameClass?: string;
}

const {
	src,
	alt,
	width = 1800,
	flip = false,
	eager = false,
	class: imgClass = '',
	frameClass = '',
} = Astro.props;
---

<div class:list={['tiltshot relative', { 'tiltshot--flip': flip }, frameClass]}>
	<Image
		src={src}
		width={width}
		alt={alt}
		loading={eager ? 'eager' : 'lazy'}
		fetchpriority={eager ? 'high' : undefined}
		class:list={['tiltshot__img w-full rounded-xl ring-1 ring-border', imgClass]}
	/>
	<slot />
</div>

<style>
	.tiltshot {
		perspective: 1600px;
	}

	@keyframes tiltshot-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-12px);
		}
	}

	/* translate (no transform) para no pisar el rotate del chip. */
	@keyframes tiltshot-float-soft {
		0%,
		100% {
			translate: 0 0;
		}
		50% {
			translate: 0 -5px;
		}
	}

	/* Bob idle continuo: la imagen va sobre el contenedor (que no tiene
	   transform propio, así compone con el tilt del hijo); los chips flotan
	   con menos amplitud y otro período para dar profundidad. Solo desktop;
	   se pausa en hover para no pelear con el "lift". */
	@media (min-width: 768px) {
		.tiltshot {
			animation: tiltshot-float 6s ease-in-out infinite;
		}
		.tiltshot--flip {
			animation-duration: 7s;
			animation-delay: -2.5s;
		}
		.tiltshot :global([data-float]) {
			animation: tiltshot-float-soft 5s ease-in-out infinite;
		}
		.tiltshot:hover,
		.tiltshot:hover :global([data-float]) {
			animation-play-state: paused;
		}
	}

	.tiltshot__img {
		transform: rotateY(-14deg) rotate(1.5deg);
		transform-origin: center;
		box-shadow:
			-34px 30px 64px -28px rgb(0 0 0 / 0.3),
			0 6px 20px -8px rgb(0 0 0 / 0.12);
		transition:
			transform 0.5s ease,
			box-shadow 0.5s ease;
	}

	/* Las capturas de la app son claras: bajamos un poco el brillo en dark. */
	:root[data-theme='dark'] .tiltshot__img {
		filter: brightness(0.9) contrast(1.02);
	}

	.tiltshot--flip .tiltshot__img {
		transform: rotateY(14deg) rotate(-1.5deg);
	}

	/* Chips flotantes que el consumidor pasa por el slot: marcarlos con
	   data-float y, opcional, --float-rot / --float-rot-hover para el ángulo.
	   Flotan sobre una captura clara de la app, así que conservan la paleta
	   light aunque el sitio esté en dark. */
	.tiltshot :global([data-float]) {
		transform: rotate(var(--float-rot, 0deg));
		transition: transform 0.5s ease;
		--color-card: oklch(1 0 0);
		--color-card-foreground: oklch(0.145 0 0);
		--color-primary: oklch(0.395 0.175 28.5);
		--color-primary-foreground: oklch(0.985 0 0);
		--color-muted: oklch(0.97 0 0);
		--color-muted-foreground: oklch(0.556 0 0);
		--color-border: oklch(0.922 0 0);
	}

	@media (hover: hover) {
		.tiltshot:hover .tiltshot__img {
			transform: rotateY(-5deg) rotate(0deg) translateY(-8px) scale(1.02);
			box-shadow:
				-22px 44px 76px -26px rgb(0 0 0 / 0.34),
				0 10px 28px -10px rgb(0 0 0 / 0.16);
		}
		.tiltshot--flip:hover .tiltshot__img {
			transform: rotateY(5deg) rotate(0deg) translateY(-8px) scale(1.02);
		}
		.tiltshot:hover :global([data-float]) {
			transform: translateY(-4px) rotate(var(--float-rot-hover, 0deg));
			translate: 0;
			transition:
				transform 0.5s ease,
				translate 0.3s ease;
		}
	}

	@media (max-width: 767px) {
		.tiltshot__img {
			transform: none;
			box-shadow: 0 20px 44px -18px rgb(0 0 0 / 0.22);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tiltshot,
		.tiltshot--flip,
		.tiltshot__img,
		.tiltshot :global([data-float]) {
			animation: none;
			transition: none;
		}
	}
</style>
