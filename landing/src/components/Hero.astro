---
import heroDashboard from '../assets/Hero.png';
import TiltedShot from './TiltedShot.astro';
import { FRONTEND_URL } from '../lib/constants';
import { getLang, useTranslations, localizePath } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const features = [t('hero.bar.1'), t('hero.bar.2'), t('hero.bar.3'), t('hero.bar.4'), t('hero.bar.5')];
---

<section class="hero relative flex flex-col overflow-hidden bg-background">
	<div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
	<div class="hero-glow hero-glow--right pointer-events-none absolute" aria-hidden="true"></div>
	<div class="hero-glow hero-glow--left pointer-events-none absolute" aria-hidden="true"></div>

	<div
		class="relative mx-auto flex w-full max-w-6xl flex-col items-center px-6 py-16 text-center md:py-24"
	>
		<span
			class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-primary"
		>
			<span class="size-1.5 rounded-full bg-primary"></span>
			{t('hero.eyebrow')}
		</span>

		<h1
			class="mt-7 max-w-4xl text-balance font-display text-5xl font-medium leading-[1.02] tracking-tight text-foreground sm:text-6xl md:text-7xl lg:text-[5.5rem] xl:text-[6.25rem]"
		>
			{t('hero.title.prefix')} <span class="italic text-primary">{t('hero.title.accent')}</span>
		</h1>

		<p class="mt-6 max-w-2xl text-balance text-lg text-muted-foreground md:text-xl">
			{t('hero.lede')}
		</p>

		<div class="mt-9 flex flex-col gap-3 sm:flex-row sm:justify-center">
			<a
				href={`${FRONTEND_URL}/register`}
				class="rounded-lg bg-primary px-7 py-3.5 text-center text-base font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90"
			>
				{t('hero.cta.register')}
			</a>
			<a
				href={localizePath('/planes', lang)}
				class="rounded-lg border border-border bg-background px-7 py-3.5 text-center text-base font-medium text-foreground transition-colors hover:bg-muted"
			>
				{t('hero.cta.plans')}
			</a>
		</div>

		<TiltedShot
			src={heroDashboard}
			width={2200}
			eager
			alt={t('hero.shotAlt')}
			frameClass="mt-14 w-full max-w-5xl md:mt-16"
		>
			<div
				data-float
				style="--float-rot: 3deg; --float-rot-hover: 2deg"
				class="absolute -top-4 left-4 hidden items-center gap-1 rounded-full border border-border bg-card p-1.5 shadow-lg sm:flex md:-top-6 md:left-2"
				aria-hidden="true"
			>
				<span class="grid size-8 place-items-center rounded-full bg-primary text-primary-foreground">
					<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="3" y="3" width="7" height="7" rx="1" />
						<rect x="14" y="3" width="7" height="7" rx="1" />
						<rect x="14" y="14" width="7" height="7" rx="1" />
						<rect x="3" y="14" width="7" height="7" rx="1" />
					</svg>
				</span>
				<span class="grid size-8 place-items-center rounded-full text-muted-foreground">
					<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<line x1="8" y1="6" x2="21" y2="6" />
						<line x1="8" y1="12" x2="21" y2="12" />
						<line x1="8" y1="18" x2="21" y2="18" />
						<line x1="3.5" y1="6" x2="3.51" y2="6" />
						<line x1="3.5" y1="12" x2="3.51" y2="12" />
						<line x1="3.5" y1="18" x2="3.51" y2="18" />
					</svg>
				</span>
				<span class="grid size-8 place-items-center rounded-full text-muted-foreground">
					<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
						<circle cx="12" cy="7" r="4" />
					</svg>
				</span>
				<span class="grid size-8 place-items-center rounded-full text-muted-foreground">
					<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
						<polyline points="16 17 21 12 16 7" />
						<line x1="21" y1="12" x2="9" y2="12" />
					</svg>
				</span>
			</div>

			<div
				data-float
				style="--float-rot: -3deg; --float-rot-hover: -2deg"
				class="absolute -bottom-4 -right-4 hidden items-center gap-3 rounded-lg border border-border bg-card p-3 shadow-lg sm:flex md:-bottom-6 md:-right-8"
			>
				<span class="flex size-9 items-center justify-center rounded-md bg-primary/10 text-primary">
					<svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
						<path
							fill-rule="evenodd"
							d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.5 7.6a1 1 0 0 1-1.42.006l-3.5-3.5a1 1 0 1 1 1.414-1.414l2.79 2.79 6.795-6.885a1 1 0 0 1 1.414-.006Z"
							clip-rule="evenodd"
						/>
					</svg>
				</span>
				<span class="pr-2">
					<span class="block text-sm font-semibold text-card-foreground">{t('hero.card.title')}</span>
					<span class="block text-xs text-muted-foreground">{t('hero.card.sub')}</span>
				</span>
			</div>
		</TiltedShot>
	</div>

	<div class="relative mt-4 border-t border-border bg-muted/40 md:mt-8">
		<ul
			class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-7 gap-y-2 px-6 py-4 md:flex-nowrap md:justify-between"
		>
			{features.map((feature) => (
				<li class="inline-flex items-center gap-1.5 whitespace-nowrap text-sm text-muted-foreground">
					<svg class="size-4 shrink-0 text-primary" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
						<path
							fill-rule="evenodd"
							d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.5 7.6a1 1 0 0 1-1.42.006l-3.5-3.5a1 1 0 1 1 1.414-1.414l2.79 2.79 6.795-6.885a1 1 0 0 1 1.414-.006Z"
							clip-rule="evenodd"
						/>
					</svg>
					{feature}
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.hero-grid {
		background-image: radial-gradient(circle, var(--color-border) 1px, transparent 1px);
		background-size: 26px 26px;
		-webkit-mask-image: radial-gradient(60% 55% at 50% 28%, #000 0%, transparent 100%);
		mask-image: radial-gradient(60% 55% at 50% 28%, #000 0%, transparent 100%);
		opacity: 0.55;
	}

	.hero-glow {
		width: 46rem;
		height: 46rem;
		border-radius: 9999px;
		background: var(--color-primary);
		filter: blur(90px);
	}

	.hero-glow--right {
		top: 8%;
		right: -6%;
		opacity: 0.12;
	}

	.hero-glow--left {
		bottom: -8%;
		left: -12%;
		width: 40rem;
		height: 40rem;
		opacity: 0.09;
	}
</style>
