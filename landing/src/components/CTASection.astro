---
import { FRONTEND_URL } from '../lib/constants';
---

<section class="border-b-[3px] border-foreground bg-foreground text-background">
	<div class="mx-auto max-w-4xl px-6 py-16 text-center md:py-24">
		<p class="font-mono text-sm font-bold uppercase tracking-widest text-accent">
			Sin fricción, sin retrasos
		</p>
		<h2 class="mt-4 text-4xl font-black uppercase leading-[0.95] tracking-tight md:text-6xl">
			Pon tu restaurante en tiempo real
		</h2>
		<p class="mx-auto mt-6 max-w-xl text-lg font-medium text-background/80">
			Únete a los restaurantes que ya gestionan mesas, comandas y analítica desde un solo panel.
		</p>
		<div class="mt-8 flex justify-center">
			<a
				href={`${FRONTEND_URL}/register`}
				class="border-[3px] border-background bg-accent px-8 py-4 text-center text-sm font-black uppercase tracking-wide text-background shadow-brutal"
			>
				Registrarme gratis
			</a>
		</div>
	</div>
</section>
