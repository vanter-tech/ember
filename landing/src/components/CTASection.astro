---
import { Image } from 'astro:assets';
import heroDashboard from '../assets/Hero.png';
import { FRONTEND_URL } from '../lib/constants';
import { getLang, useTranslations, localizePath } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="border-t border-border bg-background">
	<div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
		<div
			class="relative isolate overflow-hidden rounded-2xl border border-border bg-card px-6 py-20 text-center shadow-sm md:px-12 md:py-28"
		>
			<Image
				src={heroDashboard}
				width={1800}
				alt=""
				aria-hidden="true"
				class="cta-bg pointer-events-none absolute inset-0 -z-10 h-full w-full scale-125 object-cover blur-2xl"
			/>
			<div
				class="cta-scrim pointer-events-none absolute inset-0 -z-10 bg-card/45"
				aria-hidden="true"
			></div>
			<div class="cta-darken pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

			<span class="mx-auto block h-1 w-12 rounded-full bg-primary"></span>

			<p class="mt-6 text-xs font-semibold uppercase tracking-wider text-primary">
				{t('cta.eyebrow')}
			</p>
			<h2 class="mt-4 text-3xl font-bold leading-tight tracking-tight text-foreground md:text-5xl">
				{t('cta.title')}
			</h2>
			<p class="mx-auto mt-5 max-w-xl text-lg text-muted-foreground">
				{t('cta.lede')}
			</p>
			<div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
				<a
					href={`${FRONTEND_URL}/register`}
					class="rounded-lg bg-primary px-7 py-3.5 text-center text-base font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90"
				>
					{t('cta.register')}
				</a>
				<a
					href={localizePath('/planes', lang)}
					class="text-sm font-medium text-primary transition-colors hover:text-primary/80"
				>
					{t('cta.plans')}
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.cta-bg {
		opacity: 0.55;
	}
	.cta-darken {
		background-color: rgb(0 0 0 / 0.08);
	}
	:root[data-theme='dark'] .cta-bg {
		opacity: 0.24;
	}
	:root[data-theme='dark'] .cta-scrim {
		background-color: color-mix(in oklab, var(--color-card) 62%, transparent);
	}
	:root[data-theme='dark'] .cta-darken {
		background-color: rgb(0 0 0 / 0.35);
	}
</style>
