---
import { getFeatures } from '../lib/features';
import { getLang } from '../i18n/utils';

const FEATURES = getFeatures(getLang(Astro.currentLocale));
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
	{FEATURES.map((feature) => (
		<div class="rounded-lg border border-border bg-card p-6 shadow-sm">
			<span class="text-sm font-semibold text-primary">{feature.n}</span>
			<h3 class="mt-3 text-lg font-semibold tracking-tight text-card-foreground">{feature.title}</h3>
			<p class="mt-3 text-sm text-muted-foreground">{feature.description}</p>
		</div>
	))}
</div>
