---
const features = [
	{
		n: '01',
		title: 'Carrito colaborativo',
		description:
			'Los comensales se unen con un código QR y agregan platos a un carrito compartido en tiempo real, sin apps que instalar.',
	},
	{
		n: '02',
		title: 'Comandas en cocina (KDS)',
		description:
			'Cada pedido avanza por estados controlados — pendiente, en preparación, listo, entregado — visibles al instante en pantalla.',
	},
	{
		n: '03',
		title: 'Gestión de piso y meseros',
		description:
			'Asignación de mesas, altas manuales, división de cuentas y cierre de caja por turno, todo desde un mismo panel.',
	},
	{
		n: '04',
		title: 'Analítica para administradores',
		description:
			'Métricas de ventas, ticket promedio y desempeño por producto o mesa, filtrables por día, semana, mes o año.',
	},
];
---

<section id="features" class="border-b-[3px] border-foreground bg-background">
	<div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
		<p class="font-mono text-sm font-bold uppercase tracking-widest text-accent">
			Todo en un solo panel
		</p>
		<h2 class="mt-4 max-w-xl text-4xl font-black uppercase leading-[0.95] tracking-tight md:text-5xl">
			Hecho para el flujo real de un restaurante
		</h2>

		<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{features.map((feature) => (
				<div class="border-[3px] border-foreground bg-background p-6 shadow-brutal-sm">
					<span class="font-mono text-sm font-black text-accent">{feature.n}</span>
					<h3 class="mt-3 text-lg font-black uppercase tracking-tight">{feature.title}</h3>
					<p class="mt-3 text-sm font-medium text-foreground/80">{feature.description}</p>
				</div>
			))}
		</div>
	</div>
</section>
