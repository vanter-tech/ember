---
import { getPlans, getComparison, type Cell } from '../lib/plans';
import { getLang, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const PLANS = getPlans(lang);
const COMPARISON = getComparison(lang);

const colClass = (i: number) =>
	PLANS[i].highlighted ? 'bg-primary/[0.04]' : '';
---

<div class="overflow-x-auto">
	<table class="w-full min-w-[760px] border-separate border-spacing-0 text-sm">
		<thead>
			<tr>
				<th
					class="sticky left-0 z-10 w-[44%] bg-background p-4 text-left align-bottom text-xs font-semibold uppercase tracking-wider text-muted-foreground"
				>
					{t('ptable.heading')}
				</th>
				{PLANS.map((plan, i) => (
					<th
						class:list={[
							'border-b border-border p-4 text-center align-bottom',
							colClass(i),
						]}
					>
						<span
							class:list={[
								'block text-sm font-semibold',
								plan.highlighted ? 'text-primary' : 'text-card-foreground',
							]}
						>
							{plan.name}
						</span>
						<span class="mt-1 block text-xs font-normal text-muted-foreground">
							<span data-price-monthly={plan.priceAnnual ? '' : undefined}>{plan.price}{plan.period}</span>
							{plan.priceAnnual && (
								<span data-price-annual>{plan.priceAnnual}{plan.periodAnnual}</span>
							)}
						</span>
					</th>
				))}
			</tr>
		</thead>

		<tbody>
			{COMPARISON.map((group) => (
				<Fragment>
					<tr>
						<td
							colspan={PLANS.length + 1}
							class="sticky left-0 bg-muted/60 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-foreground"
						>
							{group.category}
						</td>
					</tr>
					{group.rows.map((row) => (
						<tr class="group">
							<th
								scope="row"
								class="sticky left-0 z-10 bg-background p-4 text-left font-normal text-muted-foreground group-hover:bg-muted/40"
							>
								{row.label}
							</th>
							{row.values.map((value: Cell, i: number) => (
								<td
									class:list={[
										'border-b border-border p-4 text-center align-middle',
										colClass(i),
									]}
								>
									{value === true && (
										<svg
											class="mx-auto size-5 text-primary"
											viewBox="0 0 20 20"
											fill="currentColor"
											aria-hidden="true"
										>
											<path
												fill-rule="evenodd"
												d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.5 7.6a1 1 0 0 1-1.42.006l-3.5-3.5a1 1 0 1 1 1.414-1.414l2.79 2.79 6.795-6.885a1 1 0 0 1 1.414-.006Z"
												clip-rule="evenodd"
											/>
										</svg>
									)}
									{value === true && <span class="sr-only">{t('ptable.included')}</span>}
									{value === false && (
										<span class="text-muted-foreground/40" aria-label={t('ptable.notIncluded')}>—</span>
									)}
									{typeof value === 'string' && (
										<span class="font-medium text-foreground">{value}</span>
									)}
								</td>
							))}
						</tr>
					))}
				</Fragment>
			))}
		</tbody>
	</table>
</div>
