---
import { getLang, useTranslations, localizePath } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-background">
	<div class="mx-auto max-w-6xl px-6 py-12">
		<div class="grid gap-10 md:grid-cols-3">
			<div>
				<div class="flex items-center gap-2.5">
					<img
						src="/ember-logo-l.png"
						alt=""
						width="142"
						height="180"
						class="site-logo site-logo--light h-8 w-auto"
					/>
					<img
						src="/ember-logo-d.png"
						alt=""
						width="142"
						height="180"
						class="site-logo site-logo--dark h-8 w-auto"
					/>
					<p class="site-wordmark text-xl font-bold tracking-tight text-foreground">Ember</p>
				</div>
				<p class="mt-3 max-w-xs text-sm text-muted-foreground">
					{t('footer.tagline')}
				</p>
				<a
					href="https://www.facebook.com/profile.php?id=61594385545934"
					target="_blank"
					rel="noreferrer"
					aria-label={t('footer.facebook')}
					class="mt-4 inline-flex size-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
				>
					<svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M22 12.06C22 6.51 17.52 2 12 2S2 6.51 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z" />
					</svg>
				</a>
			</div>

			<div>
				<p class="text-xs font-semibold uppercase tracking-wider text-primary">{t('footer.legal')}</p>
				<ul class="mt-3 space-y-2 text-sm text-muted-foreground">
					<li><a href={localizePath('/privacy', lang)} class="transition-colors hover:text-foreground">{t('footer.privacy')}</a></li>
					<li><a href={localizePath('/terms', lang)} class="transition-colors hover:text-foreground">{t('footer.terms')}</a></li>
					<li><a href={localizePath('/contacto', lang)} class="transition-colors hover:text-foreground">{t('footer.contact')}</a></li>
				</ul>
			</div>

			<div>
				<p class="text-xs font-semibold uppercase tracking-wider text-primary">Vanter</p>
				<address class="mt-3 max-w-xs text-sm not-italic text-muted-foreground">
					Managua, Nicaragua<br />
					<a href="mailto:tofernandoband01@outlook.com" class="transition-colors hover:text-foreground">tofernandoband01@outlook.com</a>
				</address>
			</div>
		</div>

		<div class="mt-10 border-t border-border pt-6 text-center text-xs text-muted-foreground">
			© {year} Ember — Vanter. {t('footer.rights')}
		</div>
	</div>
</footer>

<style>
	/* Match Nav.astro's logo lockup: show the light mark by default, swap to the
	   dark mark under the dark theme; wordmark is brand-red in light, foreground
	   in dark. Astro styles are component-scoped, so this mirrors Nav's rules. */
	.site-logo--dark {
		display: none;
	}
	:root[data-theme='dark'] .site-logo--light {
		display: none;
	}
	:root[data-theme='dark'] .site-logo--dark {
		display: block;
	}

	.site-wordmark {
		color: #8c1717;
	}
	:root[data-theme='dark'] .site-wordmark {
		color: var(--color-foreground);
	}
</style>
