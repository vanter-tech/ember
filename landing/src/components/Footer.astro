---
import Flame from './Flame.astro';
import { getLang, useTranslations, localizePath } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-background">
	<div class="mx-auto max-w-6xl px-6 py-12">
		<div class="grid gap-10 md:grid-cols-3">
			<div>
				<div class="flex items-center gap-2.5">
					<span class="flex size-8 items-center justify-center rounded-lg bg-primary text-primary-foreground shadow-sm">
						<Flame class="h-4 w-auto" />
					</span>
					<p class="text-xl font-bold tracking-tight text-foreground">Ember</p>
				</div>
				<p class="mt-3 max-w-xs text-sm text-muted-foreground">
					{t('footer.tagline')}
				</p>
			</div>

			<div>
				<p class="text-xs font-semibold uppercase tracking-wider text-primary">{t('footer.legal')}</p>
				<ul class="mt-3 space-y-2 text-sm text-muted-foreground">
					<li><a href={localizePath('/privacy', lang)} class="transition-colors hover:text-foreground">{t('footer.privacy')}</a></li>
					<li><a href={localizePath('/terms', lang)} class="transition-colors hover:text-foreground">{t('footer.terms')}</a></li>
					<li><a href={localizePath('/contacto', lang)} class="transition-colors hover:text-foreground">{t('footer.contact')}</a></li>
				</ul>
			</div>

			<div>
				<p class="text-xs font-semibold uppercase tracking-wider text-primary">Vanter</p>
				<address class="mt-3 max-w-xs text-sm not-italic text-muted-foreground">
					Managua, Nicaragua<br />
					<a href="mailto:tofernandoband01@outlook.com" class="transition-colors hover:text-foreground">tofernandoband01@outlook.com</a>
				</address>
			</div>
		</div>

		<div class="mt-10 border-t border-border pt-6 text-center text-xs text-muted-foreground">
			© {year} Ember — Vanter. {t('footer.rights')}
		</div>
	</div>
</footer>
