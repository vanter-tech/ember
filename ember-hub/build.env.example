# ember-hub/build.env.example
# Copy to ember-hub/build.env (gitignored) and fill with production values.
# These are baked into every installer, identical for all customers.
# The cloud backend serves the tenant API under the "/v1" context path, so both
# URLs must include it (they are used verbatim — HubProvisioningRunner does not
# append a path).
EMBER_HUB_ACTIVATION_URL=https://api.ember.vanter.net/v1/hub-activations
EMBER_HUB_HEARTBEAT_URL=https://api.ember.vanter.net/v1/hub-heartbeat
EMBER_HUB_SERVER_PORT=8080
