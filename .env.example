# Copy to `.env` at this same (repo root) level and fill in real values.
# The backend imports it automatically (`spring.config.import` in application.yml), and
# docker-compose feeds it to the `app` service via `env_file`.
# SPRING_DATASOURCE_PASSWORD / JWT_SECRET / PLATFORM_JWT_SECRET / MINIO_ACCESS_KEY /
# MINIO_SECRET_KEY have no in-code fallback: the app refuses to boot without them.

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ember
SPRING_DATASOURCE_USERNAME=ember
SPRING_DATASOURCE_PASSWORD=ember

# JPA
DDL_AUTO=validate

# CORS / WebSocket origins (comma-separated; shared by the REST API and the SockJS handshake)
# Exact origins:
EMBER_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Wildcard patterns for tenant subdomains, e.g. https://*.ember.vanter.com (leave empty in dev):
EMBER_CORS_ALLOWED_ORIGIN_PATTERNS=

# Auth rate limiting (/auth/login, /auth/register); buckets keyed by (tenant + client IP)
EMBER_RATELIMIT_ENABLED=true
EMBER_RATELIMIT_MAX_REQUESTS=10
EMBER_RATELIMIT_IP_MAX_REQUESTS=30
EMBER_RATELIMIT_WINDOW=60s
# Reverse proxies whose X-Forwarded-For/-Host are believed (comma-separated IPs or CIDRs).
# MUST be set once the app runs behind a load balancer, else every client looks like the proxy:
EMBER_RATELIMIT_TRUSTED_PROXIES=
# Host suffixes whose leading label is the tenant, e.g. ember.vanter.com (leave empty in dev):
EMBER_RATELIMIT_TENANT_HOST_SUFFIXES=

# JWT
JWT_SECRET=change-me-to-a-secret-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000

# Platform/super-admin console JWT — MUST be a different secret from JWT_SECRET above (that's the
# only thing that keeps a tenant token from being accepted on /platform/** and vice versa):
PLATFORM_JWT_SECRET=change-me-to-a-different-secret-at-least-32-chars
PLATFORM_JWT_EXPIRATION_MS=86400000

# MinIO
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ember-media
