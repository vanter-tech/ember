# Copy to `.env` at this same (repo root) level and fill in real values.
# The backend imports it automatically (`spring.config.import` in application.yml), and
# docker-compose feeds it to the `app` service via `env_file`.
# SPRING_DATASOURCE_PASSWORD / SPRING_DATA_MONGODB_URI / JWT_SECRET / MINIO_ACCESS_KEY /
# MINIO_SECRET_KEY have no in-code fallback: the app refuses to boot without them.

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ember
SPRING_DATASOURCE_USERNAME=ember
SPRING_DATASOURCE_PASSWORD=ember

# MongoDB
SPRING_DATA_MONGODB_URI=mongodb://ember:ember@localhost:27017/ember?authSource=admin

# JPA
DDL_AUTO=validate

# JWT
JWT_SECRET=change-me-to-a-secret-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000

# MinIO
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ember-media
